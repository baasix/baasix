{
  "name": "@baasix/lexical",
  "version": "0.0.11",
  "description": "Baasix-specific Lexical rich text editor",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./content.css": "./dist/content.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@baasix/sdk": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@atlaskit/drag-and-drop-indicator": "^0.12.0",
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.9",
    "@excalidraw/excalidraw": "^0.18.0",
    "@lexical/clipboard": "0.41.0",
    "@lexical/code": "0.41.0",
    "@lexical/code-shiki": "0.41.0",
    "@lexical/dragon": "0.41.0",
    "@lexical/extension": "^0.41.0",
    "@lexical/hashtag": "0.41.0",
    "@lexical/history": "0.41.0",
    "@lexical/html": "0.41.0",
    "@lexical/link": "0.41.0",
    "@lexical/list": "0.41.0",
    "@lexical/mark": "0.41.0",
    "@lexical/markdown": "0.41.0",
    "@lexical/offset": "0.41.0",
    "@lexical/overflow": "0.41.0",
    "@lexical/react": "0.41.0",
    "@lexical/rich-text": "0.41.0",
    "@lexical/selection": "0.41.0",
    "@lexical/table": "0.41.0",
    "@lexical/text": "0.41.0",
    "@lexical/utils": "0.41.0",
    "@lexical/yjs": "0.41.0",
    "katex": "^0.16.38",
    "lexical": "0.41.0",
    "lodash-es": "^4.17.23",
    "prettier": "^3.8.1",
    "prismjs": "^1.30.0",
    "react-day-picker": "^9.0.0",
    "react-error-boundary": "^4.0.0",
    "@floating-ui/react": "^0.27.19",
    "date-fns": "^4.1.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@baasix/sdk": "*",
    "@types/katex": "^0.16.0",
    "@types/lodash-es": "^4.17.0",
    "@types/prismjs": "^1.26.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
