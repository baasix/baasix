# =============================================================================
# BAASIX Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.
# Lines starting with # are comments. Uncomment variables to enable them.

# =============================================================================
# SERVER
# =============================================================================

# Port number the server will listen on
PORT=8056

# Log level: fatal | error | warn | info | debug | trace | silent
# Use 'debug' or 'trace' to enable verbose logging
LOG_LEVEL=info

# Include stack traces for warnings (useful for debugging)
# LOG_WARN_STACK=false

# Enable test mode (disables certain features for testing)
TEST_MODE=false

# Disable automatic expired session cleanup (useful for testing or custom cleanup)
# DISABLE_SESSION_CLEANUP=false

# Maximum request body size (default: 20mb)
# BODY_SIZE_LIMIT=20mb

# Compute the total record count on list reads by default (default: true).
# Set to false to skip the COUNT query unless a request explicitly opts in with
# `?count=true`. When off, list responses return `totalCount: null`.
# Per-request `?count=false` / `?count=true` always overrides this default.
# COUNT_BY_DEFAULT=true

# =============================================================================
# SECURITY HARDENING (all default to ON / secure — set to false to relax)
# =============================================================================
# Note: SQL-injection protection (identifier allowlisting on filter/sort/aggregate
# fields and JSONB numeric operands) is ALWAYS ON and has no relax toggle.

# Mass-assignment protection. When true (default), privilege/sensitive fields
# (role_Id, tenant_Id, userCreated_Id, userUpdated_Id, emailVerified, and hidden
# fields) are NOT granted by a `fields:["*"]` permission — they must be named
# explicitly (e.g. fields:["*","role_Id"]). Administrators are exempt (they can
# set any field; passwords are auto-hashed). Set false to disable (NOT recommended).
# (Deprecated: the old value `allow-password` still works and is equivalent to
# PROTECT_PRIVILEGE_FIELDS=true + ALLOW_PASSWORD_WRITES=true.)
# PROTECT_PRIVILEGE_FIELDS=true

# Delegated password writes. When false (default), `password` is NEVER writable by
# non-admins via the data API — even when explicitly granted (credentials belong to
# the auth flow). Set true to let a non-admin role set `password` when it is
# EXPLICITLY granted (fields:["*","password"]) — e.g. a delegated "user-manager"
# resetting subordinates' passwords. Writes are still auto-hashed.
# ALLOW_PASSWORD_WRITES=false

# Protect the baasix_File `isPublic` flag (which makes a file world-readable,
# cross-tenant, without auth). Default off (a user can set isPublic on their own
# file via a broad fields:["*"] grant — backward compatible). Set true to make it
# opt-in: writable only when the permission names it explicitly (fields:["*","isPublic"]),
# so a broad grant can't be used to silently publish files.
# PROTECT_IS_PUBLIC_FIELD=false

# Include raw DB/internal error text in API responses. Default: off in production,
# on otherwise. Raw PG messages leak schema/table/column names and act as a SQL-
# injection oracle, so production returns a generic message + a correlation id
# (grep the server logs by that id). Set true to surface details (dev/staging).
# EXPOSE_ERROR_DETAILS=false

# File path-traversal confinement. When true (default), every local-disk storage
# operation must stay within the storage root; crafted filenames that escape it
# are rejected. Null bytes are always rejected regardless of this setting.
# Set false to disable the root-confinement check (NOT recommended).
# STORAGE_PATH_CONFINEMENT=true

# Stored-XSS protection on /assets. When true (default), executable types
# (text/html, image/svg+xml, *​/javascript, xml) are forced to download instead
# of rendering inline in the app origin. Set false to allow inline (NOT recommended).
# ASSET_XSS_PROTECTION=true

# Send `X-Content-Type-Options: nosniff` on asset responses (default: true).
# ASSET_NOSNIFF=true

# Strict multi-tenant isolation (only applies when MULTI_TENANT=true). When true
# (default), a non-tenant-specific role (isTenantSpecific:false) bypasses tenant
# scoping ONLY for the administrator role — a non-admin role marked
# isTenantSpecific:false is still tenant-scoped, preventing accidental cross-tenant
# exposure from a misconfigured role. Set false to restore the legacy behavior
# where ANY isTenantSpecific:false role bypasses tenant scoping (NOT recommended).
# STRICT_TENANT_ISOLATION=true

# --- OAuth / social-login hardening (these default to the SECURE state) ---

# Allow auto-linking an OAuth login to an existing local account when the provider
# reports the email as UNVERIFIED. Default (unset/false) = secure: only link when
# the email is verified, preventing account takeover via an unverified email.
# Set true ONLY if every configured provider is trusted to verify emails.
# OAUTH_ALLOW_UNVERIFIED_LINK=false

# Allow the client-supplied "direct ID-token" sign-in path (POST /auth/social/signin
# with an idToken). Default (unset/false) = disabled. When enabled it requires a
# provider with real JWKS signature verification (Google, Apple). The normal OAuth
# redirect/callback flow is unaffected by this setting.
# OAUTH_ALLOW_DIRECT_IDTOKEN=false

# Bind the OAuth `state` to the initiating browser via an httpOnly cookie (CSRF
# defense-in-depth on top of the existing single-use, TTL-bound server-side state).
# Default (unset/false) = off, because cross-site callbacks (some SPA / mobile-webview
# setups, and Apple's cross-site POST) may not carry the cookie and would break.
# Enable in first-party web flows; for Apple set AUTH_COOKIE_SAME_SITE=none.
# OAUTH_STATE_COOKIE_BINDING=false

# --- Outbound URL fetch (SSRF) hardening ---

# Allow server-side URL fetches (upload-from-URL, workflow HTTP node) to reach
# PRIVATE / loopback / link-local / cloud-metadata addresses. Default (unset/false)
# = secure: such URLs are blocked (the resolved IP is checked, and each redirect
# hop is re-validated). Set true ONLY for a trusted internal deployment that must
# fetch internal hosts. Scheme is always restricted to http/https regardless.
# SSRF_ALLOW_PRIVATE_URL_FETCH=false

# Response timeout (ms) for server-side URL fetches (upload-from-URL): the time to
# receive the response per request/redirect hop (time-to-first-response), NOT the
# total body-download time. The downloaded size is separately capped by
# MAX_UPLOAD_FILE_SIZE. Default 15000.
# URL_FETCH_TIMEOUT_MS=15000

# --- Image transform (DoS) limits ---

# Max output width/height (px) for on-the-fly image transforms (/assets/:id?width=…).
# Larger requested dimensions are clamped to this, preventing huge-allocation DoS.
# Default 5000.
# ASSET_MAX_DIMENSION=5000

# Max input pixels the image decoder will accept (sharp limitInputPixels) —
# decompression-bomb defense. Default 100000000 (100 megapixels).
# ASSET_MAX_INPUT_PIXELS=100000000

# Note: SECRET_KEY is REQUIRED — the server refuses to start without it. A secret
# shorter than 32 characters is allowed (the server boots) but logs a loud security
# warning at startup recommending rotation to a strong, random 32+ char value.
# Rotating SECRET_KEY invalidates all existing sessions/tokens, so plan it for a
# maintenance window. JWTs are always signed/verified with HS256.
# =============================================================================
# LOG CLEANUP (Audit Log & Email Log)
# =============================================================================
# Automatic cleanup of old audit logs and email logs.
# Disabled by default - enable to automatically delete old log entries.

# Enable automatic audit log cleanup
# AUDIT_LOG_CLEANUP_ENABLED=false

# Audit log retention period in days (default: 90 days)
# Records older than this will be deleted
# AUDIT_LOG_RETENTION_DAYS=90

# Enable automatic email log cleanup
# EMAIL_LOG_CLEANUP_ENABLED=false

# Email log retention period in days (default: 30 days)
# Records older than this will be deleted
# EMAIL_LOG_RETENTION_DAYS=30

# Maximum number of requests allowed per interval
RATE_LIMIT=250

# Rate limit interval in milliseconds (5 seconds = 5000ms)
RATE_LIMIT_INTERVAL=5000

# Rate limit by user ID instead of IP (useful when multiple users share same network)
# RATE_LIMIT_BY_USER=true

# Dedicated brute-force limiter for auth-sensitive endpoints (login, magic-link,
# password reset) — much stricter than the global RATE_LIMIT above. The limit is
# counted PER (IP + target-email) pair: each account gets its own budget from a
# given IP. This protects targeted brute-force (guessing one user's password) and
# avoids locking out many users behind one shared/NAT IP. NOTE: it does NOT cap an
# IP's TOTAL attempts across many different accounts, so it does not by itself stop
# password spraying (one password tried across thousands of accounts) — put a WAF
# or per-IP edge limit in front for that. Max attempts per (IP+email) (default 10).
# AUTH_RATE_LIMIT=10
# Window for the auth limiter, in ms (default 900000 = 15 minutes).
# AUTH_RATE_LIMIT_INTERVAL=900000
# Disable the auth limiter entirely (NOT recommended). It is auto-disabled under
# TEST_MODE; set to "false" to force-enable even in test mode.
# AUTH_RATE_LIMIT_DISABLED=false

# Require email verification before user can login
REQUIRE_EMAIL_VERIFICATION=false

# =============================================================================
# SOCKET.IO (Real-time)
# =============================================================================

# Master switch for the entire workflow subsystem. Default on (backward compatible).
# Set false to fully disable workflows for a project that only uses the data API:
#   - NO item-event hooks are registered, so every read/write avoids the per-request
#     workflow-trigger overhead (performance),
#   - scheduled workflows do not run,
#   - the /workflows/* routes return 404,
#   - no workflow script/service-node code can execute.
# This also removes the workflow code-execution surface entirely (see A2/A3 in
# SECURITY_AUDIT.md) — recommended for any deployment that doesn't use workflows.
# WORKFLOWS_ENABLED=true

# Enable/disable Socket.IO for real-time updates
SOCKET_ENABLED=true

# Per-recipient row-level scoping for real-time broadcasts (A12). Default OFF: a
# change is broadcast to everyone subscribed to the collection (within the tenant),
# which is fast (one room emit) but means a subscriber whose READ permission has
# row conditions can still see other rows in their tenant over realtime. Set true
# to evaluate each subscriber's read permission against the changed row and deliver
# only to those allowed to see it — subscribers are bucketed by role so each role
# does at most one permission check per change (no condition/relCondition restriction
# → fast in-memory path, no DB; otherwise one scoped existence query). Adds per-change
# CPU/DB cost that scales with the number of DISTINCT subscriber roles on a collection.
# REALTIME_ROW_LEVEL_SCOPING=false

# Allowed origins for Socket.IO CORS (comma-separated)
SOCKET_CORS_ENABLED_ORIGINS="http://localhost:3000,http://localhost:8056"

# Socket.IO endpoint path
SOCKET_PATH=/realtime

# Enable Redis adapter for Socket.IO (required for multi-instance deployments)
SOCKET_REDIS_ENABLED=false

# Redis URL for Socket.IO adapter
SOCKET_REDIS_URL=redis://localhost:6379

# Redis key prefix for Socket.IO
SOCKET_REDIS_KEY=socket.io

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

# PostgreSQL connection URL
DATABASE_URL="postgresql://username:password@localhost:5432/baasix"

# Number of connection retry attempts on startup
DATABASE_MAX_RETRY=3

# Delay between retry attempts in milliseconds
DATABASE_RETRY_INTERVAL=5000

# Enable PostGIS extension for geospatial queries
DATABASE_POSTGIS=true

# Enable pgvector extension for vector embeddings and similarity search
DATABASE_VECTOR=false

# Path to SSL certificate file (set to false to disable SSL)
DATABASE_SSL_CERTIFICATE=false

# Reject unauthorized SSL connections
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Log SQL queries to console (requires LOG_LEVEL=debug to see output)
DATABASE_LOGGING=false

# Transaction timeout in milliseconds
TRANSACTION_TIMEOUT_MS=60000

# Maximum number of connections in the pool
DATABASE_POOL_MAX=20

# Maximum time (ms) to wait when acquiring a connection from pool
DATABASE_POOL_ACQUIRE=30000

# Time (ms) after which idle connections are closed
DATABASE_POOL_IDLE=10000

# Maximum lifetime (ms) of a connection before it's closed and recreated
DATABASE_POOL_EVICT=60000

# --- Read Replicas (Optional) ---
# Enable read replicas for read scaling
DATABASE_READ_REPLICA_ENABLED=false

# Comma-separated list of read replica URLs
DATABASE_READ_REPLICA_URLS="postgresql://username:password@localhost:5432/baasix_r1,postgresql://username:password@localhost:5432/baasix_r2"

# Read replica pool settings
DATABASE_READ_REPLICA_POOL_MAX=20
DATABASE_READ_REPLICA_POOL_ACQUIRE=30000
DATABASE_READ_REPLICA_POOL_IDLE=10000
DATABASE_READ_REPLICA_POOL_EVICT=60000

# =============================================================================
# SYSTEM CACHE (Permissions, Roles, Settings)
# =============================================================================
# The system cache handles caching for permissions, roles, and settings.
# Uses a hybrid L1 (memory) + L2 (Redis) architecture.
# These can be configured independently from the query cache below.
# Falls back to CACHE_* values if not set (backward compatible).

# System cache adapter: memory | redis | upstash
# SYSTEM_CACHE_ADAPTER=memory

# Redis connection URL for system cache
# SYSTEM_CACHE_REDIS_URL=redis://localhost:6379

# Sync interval in seconds for L1↔L2 cache synchronization
# (applies to roles, permissions, and settings caches)
# SYSTEM_CACHE_SYNC_INTERVAL=5

# Maximum system cache size in GB (for memory adapter only)
# SYSTEM_CACHE_SIZE_GB=1

# Default TTL (Time To Live) in seconds for non-hybrid keys
# SYSTEM_CACHE_TTL=30

# =============================================================================
# DATA CACHE (Drizzle ORM query results)
# =============================================================================
# The data cache handles caching for database query results.
# Used by ItemsService for read operations.

# Enable/disable data caching
DATA_CACHE_ENABLED=true

# Data cache adapter: memory | redis | upstash
# - memory: In-memory cache (single instance only)
# - redis: Redis/Valkey (recommended for production/multi-instance)
# - upstash: Upstash Redis REST API
DATA_CACHE_ADAPTER=memory

# Data cache strategy: explicit | all
# - explicit: Opt-in caching per query with .$withCache()
# - all: Cache all queries automatically
DATA_CACHE_STRATEGY=explicit

# Default TTL (Time To Live) in seconds
DATA_CACHE_TTL=300

# Maximum data cache size in GB (for memory adapter only)
DATA_CACHE_SIZE_GB=1

# Redis connection URL for data cache (for redis adapter)
# DATA_CACHE_REDIS_URL=redis://localhost:6379

# Upstash Redis REST credentials (for upstash adapter)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# =============================================================================
# JWT / AUTHENTICATION
# =============================================================================

# Secret key for JWT signing (min 32 characters recommended)
SECRET_KEY=your-secret-key-min-32-chars-change-this

# Access token expiration time in seconds (default: 1 year = 31536000)
ACCESS_TOKEN_EXPIRES_IN=31536000

# =============================================================================
# MULTI-TENANCY
# =============================================================================

# Enable multi-tenant mode
MULTI_TENANT=false

# Allow public user registration
PUBLIC_REGISTRATION=true

# Default role assigned to new users (when MULTI_TENANT=false)
DEFAULT_ROLE_REGISTERED=user

# Allowed roles for public registration (when MULTI_TENANT=true, comma-separated)
ALLOWED_ROLES_MULTI_TENANT="tenant_owner,tenant_admin,tenant_user"

# Tables that are shared across tenants (comma-separated)
# Shared asset access: make assets from specific tenants accessible cross-tenant
# Mode: "public" (anyone, no auth) or "authenticated" (any logged-in user)
# SHARED_ASSET_ACCESS_MODE=public

# Comma-separated tenant IDs whose assets should be shared
# SHARED_ASSET_TENANT_IDS=tenant-id-1,tenant-id-2

# =============================================================================
# FILE STORAGE
# =============================================================================

# Enable asset proxy for secure file access
# ASSET_PROXY_ENABLED=true

# File types to serve through secure proxy (comma-separated: video,audio,image,pdf)
# ASSET_SECURE_PROXY_URLS=video,image,pdf

# Enabled storage services (comma-separated)
STORAGE_SERVICES_ENABLED="LOCAL"

# Default storage service to use
STORAGE_DEFAULT_SERVICE="LOCAL"

# Organize stored files into a per-tenant / per-user / system folder structure.
# Default OFF (files are stored flat). When true, NEW uploads are placed under:
#   tenants/{tenantId}/users/{userId}/   — tenant user files
#   tenants/{tenantId}/system/           — tenant system-generated files
#   users/{userId}/                       — non-tenant user files
#   system/                               — non-tenant system files
# The folder prefix is stored in baasix_File.storage_folder; the full storage key is
# storage_folder + "/" + filename. EXISTING files keep working unchanged (their
# storage_folder is NULL = legacy flat layout). To move existing files into the new
# structure, call the admin endpoint POST /files/migrate-storage-structure
# (use ?dryRun=true first to preview; it is crash-safe per file, idempotent, and
# resumable — files already migrated have a storage_folder and are skipped).
# STORAGE_FOLDER_STRUCTURE=false

# Temporary file storage path
STORAGE_TEMP_PATH="../.temp"

# Maximum file upload size in MB (default: 50)
MAX_UPLOAD_FILE_SIZE=50

# --- Local Storage ---
LOCAL_STORAGE_DRIVER=LOCAL
LOCAL_STORAGE_PATH="../uploads"

# --- S3-Compatible Storage (e.g., AWS S3, DigitalOcean Spaces, MinIO) ---
# Uncomment and configure to enable S3 storage
# SPACES_STORAGE_DRIVER=S3
# SPACES_STORAGE_ENDPOINT=s3.amazonaws.com
# SPACES_STORAGE_BUCKET=your-bucket-name
# SPACES_STORAGE_ACCESS_KEY_ID=your-access-key
# SPACES_STORAGE_SECRET_ACCESS_KEY=your-secret-key
# SPACES_STORAGE_REGION=us-east-1

# =============================================================================
# EMAIL (SMTP)
# =============================================================================

# Enabled mail senders (comma-separated sender names)
# MAIL_SENDERS_ENABLED=GMAIL,SENDGRID

# Default sender to use
# MAIL_DEFAULT_SENDER=SENDGRID

# --- Gmail SMTP Configuration ---
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
# GMAIL_SMTP_SECURE=false
# GMAIL_SMTP_USER=your_gmail_username
# GMAIL_SMTP_PASS=your_gmail_app_password
# GMAIL_FROM_ADDRESS="Your Name <your_email@gmail.com>"

# --- SendGrid/Generic SMTP Configuration ---
# SENDGRID_SMTP_HOST=smtp.sendgrid.net
# SENDGRID_SMTP_PORT=587
# SENDGRID_SMTP_SECURE=false
# SENDGRID_SMTP_USER=apikey
# SENDGRID_SMTP_PASS=your_sendgrid_api_key
# SENDGRID_FROM_ADDRESS="Your App <noreply@yourdomain.com>"

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

# Allowed origins for CORS requests (comma-separated)
AUTH_CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8056"

# Allow any port for the specified origins
AUTH_CORS_ALLOW_ANY_PORT=true

# Allow credentials (cookies, authorization headers) in CORS requests
AUTH_CORS_CREDENTIALS=true

# =============================================================================
# COOKIES
# =============================================================================

# HttpOnly flag - prevents JavaScript access to cookies (recommended: true)
AUTH_COOKIE_HTTP_ONLY=true

# Secure flag - only send cookies over HTTPS (set true in production)
AUTH_COOKIE_SECURE=false

# SameSite policy: strict | lax | none
AUTH_COOKIE_SAME_SITE=lax

# Cookie path
AUTH_COOKIE_PATH=/

# Cookie domain (uncomment for cross-subdomain cookies)
# AUTH_COOKIE_DOMAIN=.yourdomain.com

# =============================================================================
# OAUTH / SOCIAL AUTHENTICATION
# =============================================================================

# Enabled auth services (comma-separated). Full supported value list:
# LOCAL,TWOFACTOR,PASSKEY,GOOGLE,FACEBOOK,APPLE,GITHUB,DISCORD,ATLASSIAN,COGNITO,
# DROPBOX,FIGMA,GITLAB,HUGGINGFACE,KAKAO,KICK,LINE,LINEAR,LINKEDIN,MICROSOFT,
# NAVER,NOTION,PAYBIN,PAYPAL,POLAR,RAILWAY,REDDIT,ROBLOX,SALESFORCE,SLACK,
# SPOTIFY,TIKTOK,TWITCH,TWITTER,VERCEL,VK,WECHAT,ZOOM
AUTH_SERVICES_ENABLED=LOCAL

# Public base URL of this API server. Required for OAuth social login — it is
# used to build the provider callback redirect_uri ({BASE_URL}/auth/callback/{provider}).
# BASE_URL=https://api.example.com

# Allowed redirect URLs after OAuth (comma-separated)
AUTH_APP_URL="http://localhost:3000,http://localhost:8056"

# --- Google OAuth ---
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Facebook OAuth ---
# FACEBOOK_CLIENT_ID=your_facebook_client_id
# FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# --- Apple Sign In ---
# APPLE_CLIENT_ID=your_apple_client_id
# APPLE_CLIENT_SECRET=your_apple_client_secret
# APPLE_TEAM_ID=your_apple_team_id
# APPLE_KEY_ID=your_apple_key_id
# APPLE_PRIVATE_KEY=your_apple_private_key

# --- GitHub OAuth ---
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# --- Discord OAuth ---
# DISCORD_CLIENT_ID=your_discord_client_id
# DISCORD_CLIENT_SECRET=your_discord_client_secret

# --- Atlassian OAuth ---
# ATLASSIAN_CLIENT_ID=your_atlassian_client_id
# ATLASSIAN_CLIENT_SECRET=your_atlassian_client_secret

# --- Amazon Cognito OAuth ---
# COGNITO_CLIENT_ID=your_cognito_app_client_id
# COGNITO_CLIENT_SECRET=your_cognito_app_client_secret
# Cognito Hosted UI domain (e.g. your-app.auth.us-east-1.amazoncognito.com)
# COGNITO_DOMAIN=your-app.auth.us-east-1.amazoncognito.com
# AWS region where the User Pool is hosted (e.g. us-east-1)
# COGNITO_REGION=us-east-1

# --- Dropbox OAuth ---
# DROPBOX_CLIENT_ID=your_dropbox_client_id
# DROPBOX_CLIENT_SECRET=your_dropbox_client_secret

# --- Figma OAuth ---
# FIGMA_CLIENT_ID=your_figma_client_id
# FIGMA_CLIENT_SECRET=your_figma_client_secret

# --- GitLab OAuth ---
# GITLAB_CLIENT_ID=your_gitlab_client_id
# GITLAB_CLIENT_SECRET=your_gitlab_client_secret

# --- Hugging Face OAuth ---
# HUGGINGFACE_CLIENT_ID=your_huggingface_client_id
# HUGGINGFACE_CLIENT_SECRET=your_huggingface_client_secret

# --- Kakao OAuth ---
# KAKAO_CLIENT_ID=your_kakao_client_id
# KAKAO_CLIENT_SECRET=your_kakao_client_secret

# --- Kick OAuth ---
# KICK_CLIENT_ID=your_kick_client_id
# KICK_CLIENT_SECRET=your_kick_client_secret

# --- LINE Login ---
# LINE_CLIENT_ID=your_line_client_id
# LINE_CLIENT_SECRET=your_line_client_secret

# --- Linear OAuth ---
# LINEAR_CLIENT_ID=your_linear_client_id
# LINEAR_CLIENT_SECRET=your_linear_client_secret

# --- LinkedIn OAuth ---
# LINKEDIN_CLIENT_ID=your_linkedin_client_id
# LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# --- Microsoft Entra ID (Azure AD) OAuth ---
# MICROSOFT_CLIENT_ID=your_microsoft_client_id
# MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
# Tenant ID (or "common" / "organizations" / "consumers"); defaults to "common"
# MICROSOFT_TENANT_ID=common

# --- Naver OAuth ---
# NAVER_CLIENT_ID=your_naver_client_id
# NAVER_CLIENT_SECRET=your_naver_client_secret

# --- Notion OAuth ---
# NOTION_CLIENT_ID=your_notion_client_id
# NOTION_CLIENT_SECRET=your_notion_client_secret

# --- Paybin OAuth ---
# PAYBIN_CLIENT_ID=your_paybin_client_id
# PAYBIN_CLIENT_SECRET=your_paybin_client_secret

# --- PayPal OAuth ---
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# --- Polar OAuth ---
# POLAR_CLIENT_ID=your_polar_client_id
# POLAR_CLIENT_SECRET=your_polar_client_secret

# --- Railway OAuth ---
# RAILWAY_CLIENT_ID=your_railway_client_id
# RAILWAY_CLIENT_SECRET=your_railway_client_secret

# --- Reddit OAuth ---
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret

# --- Roblox OAuth ---
# ROBLOX_CLIENT_ID=your_roblox_client_id
# ROBLOX_CLIENT_SECRET=your_roblox_client_secret

# --- Salesforce OAuth ---
# SALESFORCE_CLIENT_ID=your_salesforce_connected_app_client_id
# SALESFORCE_CLIENT_SECRET=your_salesforce_connected_app_client_secret

# --- Slack OAuth (Sign in with Slack / OpenID Connect) ---
# SLACK_CLIENT_ID=your_slack_client_id
# SLACK_CLIENT_SECRET=your_slack_client_secret

# --- Spotify OAuth ---
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# --- TikTok OAuth ---
# TikTok authenticates with client_key (not client_id) in its API calls, but
# the auth route's env-loading loop still gates provider registration on
# TIKTOK_CLIENT_ID being set (see PROVIDER_EXTRA_ENV in auth.route.ts) — set
# it to any non-empty placeholder so the provider is not skipped at startup.
# TIKTOK_CLIENT_ID=unused-set-any-non-empty-value
# TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
# TikTok's actual client key (sent as `client_key`, not `client_id`)
# TIKTOK_CLIENT_KEY=your_tiktok_client_key

# --- Twitch OAuth ---
# TWITCH_CLIENT_ID=your_twitch_client_id
# TWITCH_CLIENT_SECRET=your_twitch_client_secret

# --- Twitter (X) OAuth ---
# TWITTER_CLIENT_ID=your_twitter_client_id
# TWITTER_CLIENT_SECRET=your_twitter_client_secret

# --- Vercel OAuth ---
# VERCEL_CLIENT_ID=your_vercel_client_id
# VERCEL_CLIENT_SECRET=your_vercel_client_secret

# --- VK (VK ID) OAuth ---
# VK_CLIENT_ID=your_vk_client_id
# VK_CLIENT_SECRET=your_vk_client_secret

# --- WeChat OAuth ---
# WeChat uses appid/secret (not client_id/client_secret) in its API calls,
# but these map 1:1 onto Baasix's standard provider env vars:
# WECHAT_CLIENT_ID=your_wechat_appid
# WECHAT_CLIENT_SECRET=your_wechat_secret

# --- Zoom OAuth ---
# ZOOM_CLIENT_ID=your_zoom_client_id
# ZOOM_CLIENT_SECRET=your_zoom_client_secret

# =============================================================================
# PASSKEY (WEBAUTHN)
# =============================================================================

# Add PASSKEY to AUTH_SERVICES_ENABLED above to turn this on. Also requires
# PASSKEY_RP_ID to be set below — otherwise it is disabled with a startup warning.

# Relying Party ID: the domain (no scheme/port) the passkey is bound to, e.g.
# "localhost" in dev or "example.com" in production.
# PASSKEY_RP_ID=localhost

# Relying Party display name shown to the user during registration/authentication.
# PASSKEY_RP_NAME=Baasix

# Allowed origin(s) the WebAuthn ceremony must have occurred on (comma-separated,
# scheme + host + port), e.g. "http://localhost:3000,https://app.example.com".
# PASSKEY_ORIGIN=http://localhost:3000

# =============================================================================
# OPENAPI / SWAGGER
# =============================================================================

# Enable OpenAPI documentation endpoint (/openapi)
OPENAPI_ENABLED=true

# Include auth endpoints in OpenAPI docs
OPENAPI_INCLUDE_AUTH=true

# Include multi-tenant endpoints in OpenAPI docs
OPENAPI_INCLUDE_MULTI_TENANT=true

# Include schema management endpoints in OpenAPI docs
OPENAPI_INCLUDE_SCHEMA=true

# Include permission management endpoints in OpenAPI docs
OPENAPI_INCLUDE_PERMISSIONS=true

# Include settings endpoints in OpenAPI docs
OPENAPI_INCLUDE_SETTINGS=true

# Include utility endpoints in OpenAPI docs
OPENAPI_INCLUDE_UTILS=true

# Include notification endpoints in OpenAPI docs
OPENAPI_INCLUDE_NOTIFICATIONS=true


# =============================================================================
# SCHEMA ACCESS
# =============================================================================

# Allow public access to /schemas endpoints (without authentication)
# Default is true (public) for backwards compatibility and CLI type generation
# Set to 'false' for production to require permission on baasix_SchemaDefinition collection
# Admins always have access regardless of this setting
SCHEMAS_PUBLIC=false

# =============================================================================
# TASK QUEUE / BACKGROUND JOBS
# =============================================================================

# Enable the background task service
TASK_SERVICE_ENABLED=false

# Interval to refresh task list from database (in seconds)
TASK_LIST_REFRESH_INTERVAL=1800

# Time to wait for running tasks during shutdown (in seconds)
TASK_SHUTDOWN_WAIT_TIME=60

# Enable Redis for distributed task locking (required for multi-instance deployments)
# When enabled, only one instance will process tasks at a time
TASK_REDIS_ENABLED=false

# Redis URL for task service distributed locking
# Can be the same as SOCKET_REDIS_URL or a separate Redis instance
TASK_REDIS_URL=redis://localhost:6379

# Maximum concurrent tasks per instance (default: 1)
# TASK_CONCURRENCY=1

# Seconds before a Running task is considered stalled (default: 300, min: 60)
# Stalled tasks are auto-recovered (retried if max_retries > 0, else marked Error)
# TASK_STALL_TIMEOUT=300

# =============================================================================
# MIGRATIONS
# =============================================================================

# Automatically run pending migrations on startup
MIGRATIONS_AUTO_RUN=false

# Custom directory for migration files (default: ./migrations)
# MIGRATIONS_DIR=/path/to/migrations

# Baseline version for Sequelize-to-Drizzle upgrade
# Set when upgrading from Sequelize version to skip migrations up to this version
# MIGRATIONS_UPGRADE_BASELINE=0.1.0

# =============================================================================
# MCP (Model Context Protocol)
# =============================================================================
# MCP enables AI agents to interact with Baasix through a standardized protocol.
# When enabled, provides 57 tools for schema management, CRUD operations,
# permissions, realtime, and more via HTTP endpoint.

# Enable MCP server endpoint
# MCP_ENABLED=true

# Custom path for MCP endpoint (default: /mcp)
# MCP_PATH=/mcp

# Restrict which tool categories are exposed via MCP.
# Comma-separated list of: all, read, create, update, delete
# Default: all (exposes every tool)
# Example: MCP_ENABLED_ACTIONS=read          — read-only access
# Example: MCP_ENABLED_ACTIONS=read,create   — read + create only
# MCP_ENABLED_ACTIONS=all

# MCP Authentication
# ------------------
# MCP requires authentication via request headers (configured in MCP client):
# - Authorization: Bearer <token>  (direct token auth)
# - X-MCP-Email + X-MCP-Password   (email/password auth, server caches token)
#
# Configure credentials in your MCP client config (e.g., .vscode/mcp.json)
# No credentials are stored in server environment for security.

# MCP endpoints when enabled:
# - POST /mcp              - Main MCP endpoint (Streamable HTTP)
# - GET  /mcp              - SSE stream for server notifications
# - POST /mcp/stateless    - Stateless requests (no session)
# - GET  /mcp/info         - Server info and capabilities
